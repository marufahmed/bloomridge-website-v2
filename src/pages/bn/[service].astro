---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import { site } from '../../lib/site';
import { servicesBn as services } from '../../lib/services.bn';
import { cover, alt } from '../../lib/images';

export function getStaticPaths() {
  return services.map((s) => ({ params: { service: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const others = services.filter((x) => x.slug !== s.slug);
const posts = await getCollection('articlesBn', ({ data }) => !data.draft);
const related = s.related.map((id) => posts.find((p) => p.id === id)).filter(Boolean);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.name,
    serviceType: s.title,
    description: s.description,
    url: `${site.url}/bn/${s.slug}/`,
    inLanguage: 'bn',
    provider: { '@id': `${site.url}/#organization` },
    areaServed: [{ '@type': 'City', name: 'Dhaka' }, ...site.areas.map((name) => ({ '@type': 'Place', name: `${name}, Dhaka` }))],
    audience: { '@type': 'PeopleAudience', suggestedMinAge: 2, suggestedMaxAge: 10 },
    availableChannel: { '@type': 'ServiceChannel', serviceLocation: { '@id': `${site.url}/#organization` } },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'bn',
    mainEntity: s.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'হোম', item: `${site.url}/bn/` },
      { '@type': 'ListItem', position: 2, name: s.name, item: `${site.url}/bn/${s.slug}/` },
    ],
  },
];
---
<Base title={s.title} description={s.description} ogImage={s.cover} jsonLd={jsonLd}>
  <section class="band band--paper hero">
    <div class="wrap split">
      <div>
        <p class="crumbs"><a href="/bn/">ব্লুমরিজ স্প্রিংস, বনশ্রী</a></p>
        <h1>{s.h1}</h1>
        <p class="lead">{s.lead}</p>
        <div class="actions">
          <a class="btn btn--primary" href={`https://wa.me/${site.whatsapp.e164}`} rel="noopener">WhatsApp {site.whatsapp.display}</a>
          <a class="btn btn--ghost" href="/bn/#contact">ঠিকানা ও খরচ</a>
        </div>
      </div>
      <div class="arch">
        <Image src={cover(s.cover)} alt={alt[s.cover] ?? ''} widths={[600, 900, 1400]} sizes="(min-width: 56rem) 45vw, 100vw" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap"><div class="prose">
      {s.intro.map((p) => <p class="big">{p}</p>)}
    </div></div>
  </section>

  <section class="band band--sand">
    <div class="wrap split">
      <div>
        <h2>{s.who.title}</h2>
        <ul class="ticks">
          {s.who.items.map((i) => <li><Icon name="check" /> <span>{i}</span></li>)}
        </ul>
      </div>
      <div>
        <h2>{s.what.title}</h2>
        <dl class="defs">
          {s.what.items.map(([t, d]) => (<div><dt>{t}</dt><dd>{d}</dd></div>))}
        </dl>
      </div>
    </div>
  </section>

  <section class="band band--pine">
    <div class="wrap split">
      <div class="prose on-dark">
        <h2>{s.session.title}</h2>
        {s.session.text.map((p) => <p>{p}</p>)}
      </div>
      <div class="prose on-dark">
        <h2>{s.fit.title}</h2>
        {s.fit.text.map((p) => <p>{p}</p>)}
        <p><a href="/bn/faq/">অভিভাবকদের সব প্রশ্নোত্তর</a></p>
      </div>
    </div>
  </section>

  <section class="band band--paper">
    <div class="wrap">
      <Faq items={s.faq} title={`${s.name}: অভিভাবকদের প্রশ্ন`} />
    </div>
  </section>

  {related.length > 0 && (
    <section class="band band--sand">
      <div class="wrap">
        <h2>এই বিষয়ে গাইড</h2>
        <ul class="guides">{related.map((p) => <li><a href={`/bn/resources/${p!.id}/`}><b>{p!.data.title}</b><small>{p!.data.description}</small></a></li>)}</ul>
      </div>
    </section>
  )}

  <section class="band band--tight">
    <div class="wrap">
      <h2 class="h-small">বনশ্রীতে ব্লুমরিজ স্প্রিংসের অন্যান্য সেবা</h2>
      <ul class="others">
        {others.map((o) => <li><a href={`/bn/${o.slug}/`}><Icon name={o.icon} /> {o.name}</a></li>)}
      </ul>
    </div>
  </section>

  <Cta title={`${s.keyword} খুঁজছেন?`} />
</Base>

<style>
  .hero { padding-top: clamp(2rem, 4vw, 4rem); }
  .crumbs { font-size: var(--small); margin-bottom: 1rem; }
  .crumbs a { color: var(--accent-deep); }
  .big { font-size: 1.1rem; }
  .ticks { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; }
  .ticks li { display: flex; gap: 0.6rem; align-items: flex-start; }
  .ticks :global(svg) { flex: none; width: 1.2rem; height: 1.2rem; margin-top: 0.25rem; color: var(--accent-deep); }
  .defs { margin: 0; display: grid; gap: 0.9rem; }
  .defs div { padding-left: 1rem; border-left: 3px solid var(--accent); }
  .defs dt { font-family: var(--serif); font-size: 1.15rem; color: var(--pine); }
  .defs dd { margin: 0.15rem 0 0; font-size: var(--small); color: var(--muted); }
  .h-small { font-size: var(--h3); }
  .others { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
  .others a { display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; padding: 0.7rem 1rem; border-radius: 999px; background: var(--sand); color: var(--pine); font-size: 0.95rem; }
  .others a:hover { background: var(--accent-tint); }
  .guides { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); }
  .guides a { display: block; padding: 1.5rem; border-radius: 20px; background: var(--paper); text-decoration: none; height: 100%; }
  .guides b { display: block; font-family: var(--serif); font-weight: 500; font-size: 1.15rem; color: var(--pine); margin-bottom: 0.4rem; }
  .guides small { color: var(--muted); font-size: var(--small); }
  .others :global(svg) { width: 1.1em; height: 1.1em; color: var(--accent-deep); }
</style>
