---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import { site } from '../../lib/site';
import { faq, faqPage } from '../../lib/site.bn';

const all = faq.flatMap((g) => g.items);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'bn',
    mainEntity: all.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'হোম', item: `${site.url}/bn/` },
      { '@type': 'ListItem', position: 2, name: 'প্রশ্নোত্তর', item: `${site.url}/bn/faq/` },
    ],
  },
];
---
<Base title={faqPage.title} description={faqPage.description} jsonLd={jsonLd}>
  <section class="band band--paper">
    <div class="wrap">
      <p class="kicker">প্রশ্নোত্তর</p>
      <h1>{faqPage.h1}</h1>
      <p class="lead">{faqPage.lead}</p>
      <nav class="toc" aria-label="বিষয়">
        {faq.map((g, i) => <a href={`#g${i + 1}`}>{g.group}</a>)}
      </nav>
    </div>
  </section>

  {faq.map((g, i) => (
    <section id={`g${i + 1}`} class:list={['band', 'band--tight', i % 2 ? 'band--sand' : '']}>
      <div class="wrap">
        <Faq items={g.items} title={g.group} />
      </div>
    </section>
  ))}

  <section class="band band--tight">
    <div class="wrap">
      <p>আরও পড়ুন: <a href="/bn/speech-therapy-dhaka/">স্পিচ থেরাপি</a>, <a href="/bn/occupational-therapy-dhaka/">অকুপেশনাল থেরাপি</a>, <a href="/bn/special-education-dhaka/">বিশেষ শিক্ষা</a>, <a href="/bn/autism-support-dhaka/">অটিজম সহায়তা</a>, <a href="/bn/resources/">অভিভাবকদের গাইড</a>, অথবা <a href="/faq/" lang="en">questions in English</a>।</p>
    </div>
  </section>

  <Cta />
</Base>

<style>
  .toc { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
  .toc a { text-decoration: none; padding: 0.5rem 1rem; border-radius: 999px; background: var(--sand); color: var(--pine); font-size: 0.95rem; }
  .toc a:hover { background: var(--accent-tint); }
  section[id] { scroll-margin-top: 5rem; }
</style>
