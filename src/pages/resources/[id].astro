---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Cta from '../../components/Cta.astro';
import { site } from '../../lib/site';
import { cover, alt } from '../../lib/images';

export async function getStaticPaths() {
  const posts = await getCollection('articles', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props { post: CollectionEntry<'articles'> }
const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const d = post.data;
const date = (x: Date) => x.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const words = post.body?.split(/\s+/).length ?? 0;
const minutes = Math.max(1, Math.round(words / 220));

const all = (await getCollection('articles', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const related = [
  ...all.filter((p) => p.data.tags.some((t) => d.tags.includes(t))),
  ...all,
].filter((p, i, arr) => arr.indexOf(p) === i).slice(0, 3);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    image: `${site.url}/og/${d.cover}.jpg`,
    datePublished: d.pubDate.toISOString(),
    dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
    author: { '@type': 'Organization', name: site.name, url: site.url },
    publisher: { '@id': `${site.url}/#organization` },
    mainEntityOfPage: `${site.url}/resources/${post.id}/`,
    keywords: d.tags.join(', '),
    wordCount: words,
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Resources', item: `${site.url}/resources/` },
      { '@type': 'ListItem', position: 3, name: d.title, item: `${site.url}/resources/${post.id}/` },
    ],
  },
];
---
<Base title={d.title} description={d.description} type="article" ogImage={d.cover} jsonLd={jsonLd} article={{ published: d.pubDate, modified: d.updatedDate, tags: [...d.tags] }}>
  <article>
    <header class="band band--paper head">
      <div class="wrap">
        <p class="crumbs"><a href="/resources/">Guides for parents</a></p>
        <h1>{d.title}</h1>
        <p class="lead">{d.description}</p>
        <p class="meta">
          <time datetime={d.pubDate.toISOString()}>{date(d.pubDate)}</time>
          {d.updatedDate && <span> (updated {date(d.updatedDate)})</span>}
          <span> · {minutes} min read</span>
        </p>
        <div class="arch arch--wide hero-img">
          <Image src={cover(d.cover)} alt={alt[d.cover] ?? ''} widths={[720, 1080, 1536]} sizes="(min-width: 74rem) 1184px, 100vw" loading="eager" fetchpriority="high" />
        </div>
      </div>
    </header>

    <div class="band band--tight">
      <div class="wrap body">
        <div class="prose">
          <Content />
        </div>
        <aside class="side">
          <p class="side-h">About Bloomridge Springs</p>
          <p class="side-p">A child-development centre in Banasree, Dhaka, for children aged 2 to 10. Early intervention and school readiness, with speech, occupational therapy and special education in one team.</p>
          <a class="btn btn--primary" href="/contact/">Book an assessment</a>
          <p class="side-h">Services in Dhaka</p>
          <ul class="side-links">
            <li><a href="/speech-therapy-dhaka/">Speech therapy</a></li>
            <li><a href="/occupational-therapy-dhaka/">Occupational therapy</a></li>
            <li><a href="/special-education-dhaka/">Special education</a></li>
            <li><a href="/social-skills-group-dhaka/">Social skills group</a></li>
          </ul>
          <p class="side-h">Topics</p>
          <ul class="tags">{d.tags.map((t) => <li><a href={`/resources/#${t}`}>{t.replace(/-/g, ' ')}</a></li>)}</ul>
        </aside>
      </div>
    </div>
  </article>

  <section class="band band--sand">
    <div class="wrap">
      <h2>Keep reading</h2>
      <div class="grid grid--3">{related.map((p) => <ArticleCard post={p} />)}</div>
    </div>
  </section>

  <Cta />
</Base>

<style>
  .head { padding-bottom: 0; }
  .crumbs { font-size: var(--small); margin-bottom: 1rem; }
  .crumbs a { color: var(--accent-deep); }
  h1 { max-width: 20ch; }
  .hero-img { margin-top: 2rem; transform: translateY(2.5rem); aspect-ratio: 21 / 9; }
  .body { display: grid; gap: 3rem; padding-top: 2.5rem; }
  @media (min-width: 64rem) { .body { grid-template-columns: minmax(0, 1fr) 17rem; gap: 5rem; } }
  .side { align-self: start; position: sticky; top: 5.5rem; }
  .side-h { font-family: var(--serif); font-size: 1.15rem; color: var(--pine); margin: 0 0 0.5rem; }
  .side-p { font-size: var(--small); color: var(--muted); }
  .side .btn { margin: 0.25rem 0 2rem; }
  .side .tags a { text-decoration: none; text-transform: capitalize; }
  .side-links { list-style: none; padding: 0; margin: 0 0 1.75rem; display: grid; gap: 0.4rem; font-size: var(--small); }
  .side-links a { text-decoration: none; }
  .side-links a:hover { text-decoration: underline; }
</style>
