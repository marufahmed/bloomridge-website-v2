---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page is not here. Try the programs, the parent guides or contact us." noindex>
  <section class="band">
    <div class="wrap">
      <p class="kicker">404</p>
      <h1>That page is not here</h1>
      <p class="lead">The link may be old, or the address may have a typo. Here is where most people are trying to go.</p>
      <ul class="links">
        <li><a href="/early-intervention/">Early Intervention Program</a></li>
        <li><a href="/school-readiness/">School Readiness Program</a></li>
        <li><a href="/fees/">Plans and monthly fees</a></li>
        <li><a href="/resources/">Guides for parents</a></li>
        <li><a href="/contact/">Contact and book an assessment</a></li>
      </ul>
    </div>
  </section>
</Base>
<style>
  .links { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 0.6rem; font-size: 1.1rem; }
</style>
