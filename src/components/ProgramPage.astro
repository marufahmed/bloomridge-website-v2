---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Included from './Included.astro';
import WeekStrip from './WeekStrip.astro';
import Plans from './Plans.astro';
import Faq from './Faq.astro';
import Cta from './Cta.astro';
import { programs, site } from '../lib/site';
import { cover, alt } from '../lib/images';

interface Props { program: 'a' | 'b'; title: string; description: string }
const { program, title, description } = Astro.props;
const p = programs[program];
const other = programs[program === 'a' ? 'b' : 'a'];
const img = cover(p.slug);
const icons = ['hand', 'speech', 'book'] as const;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: p.name,
    serviceType: p.short,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: 'Dhaka',
    audience: { '@type': 'PeopleAudience', suggestedMinAge: program === 'a' ? 2 : 4, suggestedMaxAge: program === 'a' ? 6 : 10 },
    description,
    url: `${site.url}/${p.slug}/`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: p.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: p.name, item: `${site.url}/${p.slug}/` },
    ],
  },
];
---
<Base title={title} description={description} accent={program} ogImage={p.slug} jsonLd={jsonLd}>
  <section class="band hero">
    <div class="wrap split">
      <div>
        <p class="kicker">{p.label}. {p.ages}.</p>
        <h1>{p.short} <em>Program</em></h1>
        <p class="lead">{p.lead}</p>
        <div class="actions">
          <a class="btn btn--primary" href="/contact/">Book an assessment</a>
          <a class="btn btn--ghost" href="#plans">See plans and fees</a>
        </div>
      </div>
      <div class="arch">
        <Image src={img} alt={alt[p.slug] ?? ''} widths={[600, 900, 1400]} sizes="(min-width: 56rem) 45vw, 100vw" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="band band--paper">
    <div class="wrap split">
      <div>
        <h2>Is this the right start for your child?</h2>
        <p class="lead">{p.who}</p>
        <p>Not sure which program fits? Children are placed by what they need now, not by age alone. <a href={`/${other.slug}/`}>Read about the {other.name}</a>, or ask us and we will help you decide at the assessment.</p>
      </div>
      <div>
        <h2 class="h-small">What is included</h2>
        <Included />
      </div>
    </div>
  </section>

  <section class="band band--sand">
    <div class="wrap">
      <h2>How your child will improve</h2>
      <p class="lead">No generic outcomes. Goals are written for your child as they are today, and reviewed with you weekly.</p>
      <div class="grid grid--3 outcomes">
        {p.outcomes.map(([t, d]) => (
          <div class="outcome"><h3>{t}</h3><p>{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--pine">
    <div class="wrap split">
      <div>
        <h2>Your child's therapy team</h2>
        <p class="lead">Three therapies, one classroom. The mix for your child is set from the Student Profile and adjusted every week.</p>
        <ul class="rows">
          {p.therapies.map(([abbr, name, desc], i) => (
            <li>
              <span class="ico"><Icon name={icons[i]} /></span>
              <div><h3>{name}</h3><p>{desc}</p></div>
              <div class="stat"><b>{abbr}</b></div>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="h-small">A typical week</h2>
        <WeekStrip />
        <h3 class="group-h">Group activity session</h3>
        <p class="group">{p.group}</p>
      </div>
    </div>
  </section>

  <section class="band" id="plans">
    <div class="wrap">
      <h2>Plans and monthly fees</h2>
      <p class="lead">Choose the level of one-to-one support. Every plan includes the school sessions, the group session, the weekly review and take-home materials.</p>
      <Plans />
      <p class="meta seats">{site.seats} seats only, so that every child is known by every adult in the room.</p>
    </div>
  </section>

  <section class="band band--paper">
    <div class="wrap">
      <Faq items={p.faq} />
    </div>
  </section>

  <Cta />
</Base>

<style>
  .hero { padding-top: clamp(2rem, 4vw, 4rem); }
  .hero h1 em { font-style: italic; font-weight: 400; }
  .h-small { font-size: var(--h3); margin-bottom: 1rem; }
  .outcomes { margin-top: 2rem; }
  .outcome { padding-top: 1.25rem; border-top: 2px solid var(--accent); }
  .outcome h3 { font-size: 1.3rem; }
  .outcome p { color: var(--muted); font-size: var(--small); margin: 0; }
  .group-h { font-size: 1.15rem; margin: 1.75rem 0 0.4rem; }
  .group { font-size: var(--small); color: rgba(251, 248, 241, 0.82); margin: 0; }
  .seats { margin-top: 1.5rem; }
</style>
