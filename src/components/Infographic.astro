---
// The shareable one-image summary for this page, if src/lib/infographics.json
// has one. The same file is what gets posted on Facebook and Instagram.
import infographics from '../lib/infographics.json';
const e = infographics.find((x) => x.page === Astro.url.pathname);
const src = e && `/infographics/${e.id}.jpg`;
---
{e && (
  <section class="band band--tight">
    <div class="wrap info">
      <a href={src} class="pic"><img src={src} alt={e.alt} width="1080" height="1350" loading="lazy" decoding="async" /></a>
      <div>
        <h2>This page in one picture</h2>
        <p>Save it, or send it to someone who is wondering about the same thing.</p>
        <a class="btn btn--ghost" href={src} download>Download the image</a>
      </div>
    </div>
  </section>
)}

<style>
  .info { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 48rem) { .info { grid-template-columns: minmax(0, 24rem) 1fr; gap: 4rem; } }
  .pic { display: block; max-width: 24rem; }
  .pic img { display: block; width: 100%; height: auto; border-radius: 22px; border: 1px solid var(--hair); }
  h2 { font-size: var(--h3); }
  p { color: var(--muted); max-width: 34ch; }
</style>
