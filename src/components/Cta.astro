---
import { site } from '../lib/site';
import Icon from './Icon.astro';
interface Props { title?: string; text?: string }
const {
  title = 'Is this the right start for your child?',
  text = 'Call or message us. We will talk through what you are seeing, and if it makes sense, book a strengths-first assessment.',
} = Astro.props;
---
<section class="band band--pine cta">
  <div class="wrap inner">
    <div>
      <h2>{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="actions">
      <a class="btn btn--accent" href={`https://wa.me/${site.whatsapp.e164}?text=${encodeURIComponent('Hello Bloomridge Springs, I would like to ask about an assessment for my child.')}`} rel="noopener"><Icon name="whatsapp" /> WhatsApp us</a>
      <a class="btn btn--ghost" href={`tel:${site.phones[0].e164}`}><Icon name="phone" /> {site.phones[0].display}</a>
      <a class="link" href="/contact/">All the ways to reach us</a>
    </div>
  </div>
</section>

<style>
  .cta { position: relative; overflow: hidden; }
  .cta::after {
    content: ''; position: absolute; right: -6rem; bottom: -8rem; width: 26rem; height: 26rem;
    background: url('/brand/logo-cream.png') no-repeat center / contain; opacity: 0.06; pointer-events: none;
  }
  .inner { display: grid; gap: 1.5rem 3rem; align-items: center; position: relative; }
  @media (min-width: 56rem) { .inner { grid-template-columns: 1.2fr 1fr; } .actions { justify-content: flex-end; } }
  .actions { margin-top: 0; }
  .link { font-size: 0.95rem; }
</style>
