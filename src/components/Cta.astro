---
import { site } from '../lib/site';
import Icon from './Icon.astro';
import { langOf } from '../lib/i18n';
interface Props { title?: string; text?: string }
const bn = langOf(Astro.url.pathname) === 'bn';
const {
  title = bn ? 'আপনার শিশুর জন্য কি এটাই সঠিক শুরু?' : 'Is this the right start for your child?',
  text = bn
    ? 'ফোন বা WhatsApp করুন। আপনি যা দেখছেন তা আমরা মন দিয়ে শুনব, সত্যি কথা বলব ব্লুমরিজ আপনার শিশুর জন্য উপযুক্ত কি না, আর প্রয়োজন হলে একটি অ্যাসেসমেন্ট ঠিক করব।'
    : 'Call or message us. We will talk through what you are seeing, and if it makes sense, book a strengths-first assessment.',
} = Astro.props;
const waText = bn
  ? 'হ্যালো ব্লুমরিজ স্প্রিংস, আমার শিশুর অ্যাসেসমেন্টের ব্যাপারে জানতে চাই।'
  : 'Hello Bloomridge Springs, I would like to ask about an assessment for my child.';
---
<section class="band band--pine cta">
  <div class="wrap inner">
    <div>
      <h2>{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="actions">
      <a class="btn btn--accent" href={`https://wa.me/${site.whatsapp.e164}?text=${encodeURIComponent(waText)}`} rel="noopener"><Icon name="whatsapp" /> {bn ? 'WhatsApp করুন' : 'WhatsApp us'}</a>
      <a class="btn btn--ghost" href={`tel:${site.phones[0].e164}`}><Icon name="phone" /> {site.phones[0].display}</a>
      <a class="link" href={bn ? '/bn/#contact' : '/contact/'}>{bn ? 'যোগাযোগের সব উপায়' : 'All the ways to reach us'}</a>
    </div>
  </div>
</section>

<style>
  .cta { position: relative; overflow: hidden; }
  .cta::after {
    content: ''; position: absolute; right: -6rem; bottom: -8rem; width: 26rem; height: 26rem;
    background: url('/brand/logo-cream.png') no-repeat center / contain; opacity: 0.06; pointer-events: none;
  }
  .inner { display: grid; gap: 1.5rem 3rem; align-items: center; position: relative; }
  @media (min-width: 56rem) { .inner { grid-template-columns: 1.2fr 1fr; } .actions { justify-content: flex-end; } }
  .actions { margin-top: 0; }
  .link { font-size: 0.95rem; }
</style>
