---
interface Props { items: readonly (readonly [string, string])[]; title?: string }
const { items, title = 'Questions parents ask' } = Astro.props;
---
<section class="faq">
  <h2>{title}</h2>
  <div class="list">
    {items.map(([q, a]) => (
      <details>
        <summary>{q}</summary>
        <p>{a}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .faq h2 { margin-bottom: 1.25rem; }
  .list { border-top: 1px solid var(--hair); max-width: 62rem; }
  details { border-bottom: 1px solid var(--hair); }
  summary { cursor: pointer; padding: 1.1rem 2.5rem 1.1rem 0; font-family: var(--serif); font-size: 1.2rem; color: var(--pine); list-style: none; position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 0.25rem; top: 50%; transform: translateY(-50%); font-family: var(--sans); font-size: 1.5rem; color: var(--accent-deep); transition: transform 0.2s; }
  details[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  details p { margin: 0 0 1.25rem; max-width: 62ch; color: var(--muted); }
</style>
